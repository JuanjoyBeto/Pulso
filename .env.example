# Copiar este archivo como .env y completar con los datos reales.
# El archivo .env NO se sube al repositorio.

# Correo (recuperación de contraseña, pagos aprobados y avisos)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=tu_correo@gmail.com
SMTP_PASS="contraseña de aplicación de Gmail"

# Inicio de sesión con Google
GOOGLE_CLIENT_ID=tu_client_id
GOOGLE_CLIENT_SECRET=tu_client_secret
GOOGLE_REDIRECT_URI=https://tu-dominio/google_callback.php

# MercadoPago (Access Token de tu aplicación; usá el de prueba TEST-... para probar)
MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxx

# WhatsApp — elegí UNO de los tres servicios y completá solo sus datos
WA_PROVEEDOR=greenapi

# Green-API (console.green-api.com)
GREEN_API_URL=https://XXXX.api.greenapi.com
GREEN_ID_INSTANCE=0000000000
GREEN_API_TOKEN=tu_api_token_instance

# Twilio (WA_PROVEEDOR=twilio)
# TWILIO_SID=ACxxxxxxxx
# TWILIO_TOKEN=xxxxxxxx
# TWILIO_FROM=+14155238886

# Meta WhatsApp Cloud API (WA_PROVEEDOR=meta)
# WA_TOKEN=EAAxxxxxxxx
# WA_PHONE_ID=000000000000000
